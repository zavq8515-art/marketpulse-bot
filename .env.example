# 1) @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Kanal (bot shu kanalda ADMIN bo'lishi shart)
TELEGRAM_CHANNEL=@MarketPulseZK

# 3) Google AI Studio kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Sozlamalar ---
# Har necha daqiqada manbalar tekshirilsin
CHECK_INTERVAL_MIN=10
# Kunlik maksimal postlar soni
MAX_POSTS_PER_DAY=50
# Bir tekshiruvda maksimal postlar
MAX_POSTS_PER_RUN=3
# Postlar orasidagi minimal oraliq (daqiqa)
MIN_GAP_MIN=3
# Faqat shu bahodan (1-10) yuqori yangiliklar chiqadi
MIN_IMPORTANCE=5
# Necha soatdan eski yangiliklar e'tiborsiz qoldiriladi
MAX_NEWS_AGE_HOURS=6
# Tungi tinchlik (Toshkent vaqti). Bo'sh qoldirsangiz o'chadi. Masalan: 01-07
QUIET_HOURS=01-07
# true bo'lsa kanalga yubormaydi, faqat konsolga chiqaradi (sinov uchun)
DRY_RUN=true
